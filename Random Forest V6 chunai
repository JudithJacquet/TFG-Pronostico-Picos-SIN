    {
      "cell_type": "code",
      "source": [
        "print(\"5. Generando Ensamble Final V6 y Resultados...\")\n",
        "df_res = pd.DataFrame({\n",
        "    'FECHA': test.index,\n",
        "    'SIN_MAX_REAL': test['SIN_max'].values,\n",
        "    'PRED_V2': pred_v2,\n",
        "    'PRED_V3': pred_v3,\n",
        "    'MONTH': test['month'].values\n",
        "})\n",
        "\n",
        "# Ensamble por época del año\n",
        "df_res['SIN_MAX_PRED'] = np.where(df_res['MONTH'].isin([12, 1, 2, 3]), df_res['PRED_V3'], df_res['PRED_V2'])\n",
        "\n",
        "# Cálculo de Errores\n",
        "df_res['ERROR_MW'] = df_res['SIN_MAX_REAL'] - df_res['SIN_MAX_PRED']\n",
        "df_res['ERROR_ABS_MW'] = np.abs(df_res['ERROR_MW'])\n",
        "df_res['ERROR_PORCENTUAL_%'] = (df_res['ERROR_ABS_MW'] / df_res['SIN_MAX_REAL']) * 100\n",
        "\n",
        "mae_g = df_res['ERROR_ABS_MW'].mean()\n",
        "rmse_g = np.sqrt((df_res['ERROR_MW']**2).mean())\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(f\"V6 DEFINITIVA MEJORADA -> MAE: {mae_g:.2f} MW | RMSE: {rmse_g:.2f} MW\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "# Descripciones en español para la tesis\n",
        "dias_esp = {0: 'Lunes', 1: 'Martes', 2: 'Miércoles', 3: 'Jueves', 4: 'Viernes', 5: 'Sábado', 6: 'Domingo'}\n",
        "df_res['DIA_SEMANA'] = df_res['FECHA'].dt.dayofweek.map(dias_esp)\n",
        "df_res['RECESO_ESCOLAR'] = np.where((df_res['MONTH'].isin([12, 1, 2])) | ((df_res['MONTH'] == 11) & (df_res['FECHA'].dt.day >= 15)) | ((df_res['MONTH'] == 7) & (df_res['FECHA'].dt.day >= 10) & (df_res['FECHA'].dt.day <= 25)), 'SI', 'NO')\n",
        "\n",
        "# Ordenar columnas\n",
        "columnas = ['FECHA', 'MONTH', 'DIA_SEMANA', 'RECESO_ESCOLAR', 'SIN_MAX_REAL', 'SIN_MAX_PRED', 'ERROR_MW', 'ERROR_ABS_MW', 'ERROR_PORCENTUAL_%']\n",
        "df_res = df_res[columnas]\n",
        "\n",
        "# Exportar el resultado\n",
        "csv_filename = 'predicciones_v6_tesis_mejorada.csv'\n",
        "df_res.to_csv(csv_filename, index=False)\n",
