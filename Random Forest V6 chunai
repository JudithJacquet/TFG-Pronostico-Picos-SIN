        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import optuna\n",
        "from optuna.samplers import TPESampler\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import Ridge\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "import holidays\n",
        "from google.colab import files\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "optuna.logging.set_verbosity(optuna.logging.WARNING)\n",
        "plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')\n",
        "print(\"Librerías importadas correctamente.\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"1. Cargando datos e integrando Feriados de Paraguay...\")\n",
        "# Asegúrate de tener 'complete-dataset.csv' subido al Colab\n",
        "df = pd.read_csv('/content/drive/MyDrive/Fabri/complete-dataset.csv', index_col='DATETIME')\n",
        "df.index = pd.to_datetime(df.index, utc=True).tz_localize(None)\n",
        "\n",
        "# Agrupación diaria\n",
        "df_daily = df.resample('D').agg({'SIN': 'max', 'T02M': 'mean', 'ISHOLIDAY': 'max'})\n",
        "df_daily.columns = ['SIN_max', 'T02M_mean', 'ISHOLIDAY_max']\n",
        "\n",
        "# Feriados PY\n",
        "py_holidays = holidays.Paraguay(years=range(2015, 2024))\n",
        "df_daily['is_py_holiday'] = df_daily.index.map(lambda x: x in py_holidays).astype(int)\n",
        "df_daily['is_holiday_eve'] = df_daily['is_py_holiday'].shift(-1).fillna(0).astype(int)\n",
        "df_daily['is_dec_24_31'] = ((df_daily.index.month == 12) & (df_daily.index.day.isin([24, 31]))).astype(int)\n",
        "\n",
        "# Fechas de corte\n",
        "FIN_VAL   = pd.Timestamp('2019-12-31 23:00:00')\n",
        "INICIO_TEST = pd.Timestamp('2020-01-01 00:00:00')\n",
        "FIN_TRAIN = pd.Timestamp('2017-12-31 23:00:00')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "zMRAq5Ba1kle",
        "outputId": "bbd694ed-3a98-41d8-e371-5a5de5682be4"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1. Cargando datos e integrando Feriados de Paraguay...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"2. Generando Variables y Receso Escolar...\")\n",
        "df_feat = df_daily.copy()\n",
        "\n",
        "# Transformación de Target y Variables Temporales\n",
        "df_feat['SIN_max_diff7'] = df_feat['SIN_max'].diff(7)\n",
        "df_feat['T02M_diff1'] = df_feat['T02M_mean'].diff(1)\n",
        "df_feat['T02M_diff7'] = df_feat['T02M_mean'].diff(7)\n",
        "\n",
        "# Shock Térmico y Olas de Calor\n",
        "df_feat['temp_shock'] = (df_feat['T02M_diff1'] > 4.0).astype(int)\n",
        "df_feat['T02M_excess_30'] = np.maximum(0, df_feat['T02M_mean'] - 30)\n",
        "df_feat['T02M_excess_30_sq'] = df_feat['T02M_excess_30'] ** 2\n",
        "\n",
        "is_hot = (df_feat['T02M_mean'] > 31.0).astype(int)\n",
        "df_feat['extreme_heatwave'] = (is_hot.rolling(window=3).sum() == 3).astype(int)\n",
        "\n",
        "# Variables de tiempo y trabajo\n",
        "df_feat['dayofweek'] = df_feat.index.dayofweek\n",
        "df_feat['month'] = df_feat.index.month\n",
        "df_feat['is_weekend'] = (df_feat.index.dayofweek >= 5).astype(int)\n",
        "df_feat['is_workday'] = ((df_feat['is_weekend'] == 0) & (df_feat['is_py_holiday'] == 0)).astype(int)\n",
        "df_feat['is_summer'] = df_feat['month'].isin([12, 1, 2, 3]).astype(int)\n",
        "\n",
        "# Lógica de Receso Escolar de Paraguay\n",
        "receso_verano = (df_feat['month'].isin([12, 1, 2])) | ((df_feat['month'] == 11) & (df_feat.index.day >= 15))\n",
        "receso_invierno = (df_feat['month'] == 7) & (df_feat.index.day >= 10) & (df_feat.index.day <= 25)\n",
        "df_feat['receso_escolar'] = (receso_verano | receso_invierno).astype(int)\n",
        "\n",
        "# Lags\n",
        "for lag in [1, 2, 3, 7, 14, 21]: df_feat[f'SIN_max_lag_{lag}'] = df_feat['SIN_max'].shift(lag)\n",
        "for lag in [1, 2, 3, 7]: df_feat[f'T02M_mean_lag_{lag}'] = df_feat['T02M_mean'].shift(lag)\n",
        "df_feat['T02M_mean_roll3'] = df_feat['T02M_mean'].shift(1).rolling(window=3).mean()\n",
        "\n",
        "# Eliminamos NA y separamos conjuntos\n",
        "df_feat = df_feat.dropna()\n",
        "train_val = df_feat[df_feat.index <= FIN_VAL]\n",
        "test = df_feat[df_feat.index >= INICIO_TEST]\n",
        "base_test = test['SIN_max_lag_7'].values"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "evjLGh7j1nmq",
        "outputId": "b8ef8d3e-e858-40c4-b6f8-79cb53a5ce3e"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "2. Generando Variables y Receso Escolar...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def calculate_weights(df_subset):\n",
        "    w = np.ones(len(df_subset))\n",
        "    w[df_subset['month'].isin([12, 1, 2, 3])] *= 2.0\n",
        "    w[df_subset['receso_escolar'] == 1] *= 1.5\n",
        "    w[df_subset['month'].isin([9, 10])] *= 2.5\n",
        "    w[df_subset['dayofweek'].isin([0, 4])] *= 1.5\n",
        "    w[df_subset['temp_shock'] == 1] *= 3.0\n",
        "    w[df_subset['extreme_heatwave'] == 1] *= 3.0\n",
        "    return w\n",
        "\n",
        "w_tr = calculate_weights(train_val[train_val.index <= FIN_TRAIN])\n",
        "w_all = calculate_weights(train_val)"
      ],
      "metadata": {
        "id": "_E2_PayX1rmZ"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"3. Optimizando Modelo v2 (Resto del año) - 50 pruebas...\")\n",
        "feat_v2 = [c for c in df_feat.columns if c not in ['SIN_max', 'SIN_max_diff7', 'T02M_mean', 'ISHOLIDAY_max', 'is_summer', 'extreme_heatwave']]\n",
        "\n",
        "X_tr_v2, y_tr_v2 = train_val[train_val.index <= FIN_TRAIN][feat_v2], train_val[train_val.index <= FIN_TRAIN]['SIN_max_diff7']\n",
        "X_val_v2 = train_val[train_val.index > FIN_TRAIN][feat_v2]\n",
        "base_val_v2 = train_val[train_val.index > FIN_TRAIN]['SIN_max_lag_7'].values\n",
        "real_val_v2 = train_val[train_val.index > FIN_TRAIN]['SIN_max'].values\n",
        "\n",
        "def objective_v2(trial):\n",
        "    alpha = trial.suggest_float('ridge_alpha', 10.0, 200.0)\n",
        "    n_est = trial.suggest_int('rf_n_estimators', 50, 200)\n",
        "    max_d = trial.suggest_int('rf_max_depth', 5, 20)\n",
        "\n",
        "    pipe = Pipeline([('scaler', StandardScaler()), ('regressor', Ridge(alpha=alpha))])\n",
        "    pipe.fit(X_tr_v2, y_tr_v2) # RIDGE SIN PESOS\n",
        "\n",
        "    rf = RandomForestRegressor(n_estimators=n_est, max_depth=max_d, random_state=42, n_jobs=-1)\n",
        "    rf.fit(X_tr_v2, y_tr_v2 - pipe.predict(X_tr_v2), sample_weight=w_tr) # RF CON PESOS\n",
        "\n",
        "    return mean_absolute_error(real_val_v2, pipe.predict(X_val_v2) + rf.predict(X_val_v2) + base_val_v2)\n",
        "\n",
        "study_v2 = optuna.create_study(direction='minimize', sampler=TPESampler(seed=42))\n",
        "study_v2.optimize(objective_v2, n_trials=50)\n",
        "\n",
        "# Entrenamiento Final\n",
        "pipe_v2 = Pipeline([('scaler', StandardScaler()), ('regressor', Ridge(alpha=study_v2.best_params['ridge_alpha']))])\n",
        "pipe_v2.fit(train_val[feat_v2], train_val['SIN_max_diff7'])\n",
        "rf_v2 = RandomForestRegressor(n_estimators=study_v2.best_params['rf_n_estimators'], max_depth=study_v2.best_params['rf_max_depth'], random_state=42, n_jobs=-1)\n",
        "rf_v2.fit(train_val[feat_v2], train_val['SIN_max_diff7'] - pipe_v2.predict(train_val[feat_v2]), sample_weight=w_all)\n",
        "\n",
        "pred_v2 = np.clip(pipe_v2.predict(test[feat_v2]) + rf_v2.predict(test[feat_v2]), -base_test * 0.35, base_test * 0.35) + base_test"
      ],
      "metadata": {
