          "name": "stdout",
          "text": [
            "3. Optimizando Modelo v2 (Resto del año) - 50 pruebas...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"4. Optimizando Modelo v3 (Verano) - 50 pruebas...\")\n",
        "feat_v3 = [c for c in df_feat.columns if c not in ['SIN_max', 'SIN_max_diff7', 'T02M_mean', 'ISHOLIDAY_max']]\n",
        "\n",
        "X_tr_v3, y_tr_v3 = train_val[train_val.index <= FIN_TRAIN][feat_v3], train_val[train_val.index <= FIN_TRAIN]['SIN_max_diff7']\n",
        "X_val_v3 = train_val[train_val.index > FIN_TRAIN][feat_v3]\n",
        "base_val_v3 = train_val[train_val.index > FIN_TRAIN]['SIN_max_lag_7'].values\n",
        "real_val_v3 = train_val[train_val.index > FIN_TRAIN]['SIN_max'].values\n",
        "mask_ver_val = train_val[train_val.index > FIN_TRAIN]['month'].isin([12, 1, 2, 3])\n",
        "\n",
        "def objective_v3(trial):\n",
        "    alpha = trial.suggest_float('ridge_alpha', 50.0, 300.0)\n",
        "    n_est = trial.suggest_int('rf_n_estimators', 50, 200)\n",
        "    max_d = trial.suggest_int('rf_max_depth', 5, 15)\n",
        "\n",
        "    pipe = Pipeline([('scaler', StandardScaler()), ('regressor', Ridge(alpha=alpha))])\n",
        "    pipe.fit(X_tr_v3, y_tr_v3) # RIDGE SIN PESOS\n",
        "\n",
        "    rf = RandomForestRegressor(n_estimators=n_est, max_depth=max_d, random_state=42, n_jobs=-1)\n",
        "    rf.fit(X_tr_v3, y_tr_v3 - pipe.predict(X_tr_v3), sample_weight=w_tr) # RF CON PESOS\n",
        "\n",
        "    pred = pipe.predict(X_val_v3) + rf.predict(X_val_v3) + base_val_v3\n",
        "    return mean_absolute_error(real_val_v3[mask_ver_val], pred[mask_ver_val])\n",
        "\n",
        "study_v3 = optuna.create_study(direction='minimize', sampler=TPESampler(seed=42))\n",
        "study_v3.optimize(objective_v3, n_trials=50)\n",
        "\n",
        "# Entrenamiento Final\n",
        "pipe_v3 = Pipeline([('scaler', StandardScaler()), ('regressor', Ridge(alpha=study_v3.best_params['ridge_alpha']))])\n",
        "pipe_v3.fit(train_val[feat_v3], train_val['SIN_max_diff7'])\n",
        "rf_v3 = RandomForestRegressor(n_estimators=study_v3.best_params['rf_n_estimators'], max_depth=study_v3.best_params['rf_max_depth'], random_state=42, n_jobs=-1)\n",
        "rf_v3.fit(train_val[feat_v3], train_val['SIN_max_diff7'] - pipe_v3.predict(train_val[feat_v3]), sample_weight=w_all)\n",
        "\n",
        "pred_v3 = np.clip(pipe_v3.predict(test[feat_v3]) + rf_v3.predict(test[feat_v3]), -base_test * 0.40, base_test * 0.40) + base_test"
      ],
