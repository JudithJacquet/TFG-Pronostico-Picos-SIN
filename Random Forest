        "\n",
        "def calcular_sensacion_termica(t_celsius, rh):\n",
        "    \"\"\"\n",
        "    Calcula el Heat Index (Sensación Térmica) usando la fórmula del NWS.\n",
        "    t_celsius: Temperatura en °C\n",
        "    rh: Humedad Relativa en %\n",
        "    \"\"\"\n",
        "    # Convertir Celsius a Fahrenheit\n",
        "    T = (t_celsius * 9/5) + 32\n",
        "\n",
        "    # Fórmula simple (para temperaturas menores a 80°F / ~26.7°C)\n",
        "    HI_simple = 0.5 * (T + 61.0 + ((T - 68.0) * 1.2) + (rh * 0.094))\n",
        "\n",
        "    # Fórmula completa de Rothfusz (para temperaturas de 80°F o más)\n",
        "    HI_full = (-42.379 + 2.04901523*T + 10.14333127*rh -\n",
        "               0.22475541*T*rh - 6.83783e-3*(T**2) -\n",
        "               5.481717e-2*(rh**2) + 1.22874e-3*(T**2)*rh +\n",
        "               8.5282e-4*T*(rh**2) - 1.99e-6*(T**2)*(rh**2))\n",
        "\n",
        "    # Crear una máscara: si la temperatura es mayor o igual a 80°F, se usa la fórmula completa\n",
        "    mask = T >= 80\n",
        "\n",
        "    # Combinar ambas fórmulas según la temperatura\n",
        "    HI_Fahrenheit = np.where(mask, HI_full, HI_simple)\n",
        "\n",
        "    # Convertir el resultado final de vuelta a Celsius\n",
        "    HI_Celsius = (HI_Fahrenheit - 32) * 5/9\n",
        "\n",
        "    return HI_Celsius\n",
