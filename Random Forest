        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "\n",
        "# ==============================================================================\n",
        "# 1. CARGA DE DATOS Y AJUSTE DE TIMEZONE\n",
        "# ==============================================================================\n",
        "# Cargamos el CSV indicando que DATETIME es índice y fecha\n",
        "df = pd.read_csv('complete-dataset.csv', parse_dates=['DATETIME'], index_col='DATETIME')\n",
        "\n",
        "# ¡Paso crucial! Convertimos a UTC y luego le quitamos la información de zona horaria (tz-naive)\n",
        "# Esto alinea los datos correctamente al horario local (Paraguay).\n",
        "df.index = pd.to_datetime(df.index, utc=True)\n",
        "df.index = df.index.tz_localize(None)\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. RESUMEN DIARIO (RESAMPLE)\n",
        "# ==============================================================================\n",
        "# Como predecir hora por hora es muy ruidoso, pasamos a predecir el pico diario.\n",
        "df_daily = df.resample('D').agg({\n",
        "    'SIN': ['mean', 'max', 'min', 'std'],\n",
        "    'T02M': 'mean',          # Temperatura\n",
        "    'RH2M': 'mean',          # Humedad\n",
        "    'ISHOLIDAY': 'max'       # Feriados\n",
        "})\n",
        "# Aplanamos los nombres de las columnas para que queden como 'SIN_max', 'T02M_mean', etc.\n",
        "df_daily.columns = ['_'.join(col).strip() for col in df_daily.columns.values]\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. INGENIERÍA DE FEATURES (VARIABLES PREDICTORAS)\n",
        "# ==============================================================================\n",
        "df_feat = df_daily.copy()\n",
        "\n",
        "# VARIABLE OBJETIVO: Vamos a predecir la diferencia de demanda respecto a hace 7 días\n",
        "df_feat['SIN_max_diff7'] = df_feat['SIN_max'].diff(7)\n",
        "\n",
        "# VARIABLES PREDICTORAS (Lags): Le enseñamos al modelo qué pasó en días anteriores\n",
        "for lag in [1, 2, 3, 7, 14]:\n",
        "    df_feat[f'SIN_max_lag_{lag}'] = df_feat['SIN_max'].shift(lag)\n",
        "\n",
        "# Clima e información del calendario\n",
        "df_feat['T02M_mean_lag_1'] = df_feat['T02M_mean'].shift(1)  # Temperatura de ayer\n",
        "df_feat['dayofweek'] = df_feat.index.dayofweek              # Día de la semana (0=Lunes, 6=Domingo)\n",
        "df_feat['month'] = df_feat.index.month                      # Mes del año (1 a 12)\n",
        "\n",
        "# Al hacer shifts (retrasos), los primeros días se quedan sin datos (NaN). Los eliminamos.\n",
        "df_feat = df_feat.dropna()\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. DIVISIÓN DE DATOS (SPLIT 80/20)\n",
        "# ==============================================================================\n",
        "# Seleccionamos qué columnas usará el modelo para predecir\n",
        "feature_cols = [c for c in df_feat.columns if 'lag' in c or c in ['dayofweek', 'month', 'ISHOLIDAY_max']]\n",
        "\n",
        "# Dividimos respetando el orden del tiempo (no podemos mezclar futuro con pasado)\n",
        "split_idx = int(0.8 * len(df_feat))\n",
        "train = df_feat.iloc[:split_idx]\n",
        "test = df_feat.iloc[split_idx:]\n",
        "\n",
        "# Separamos la \"X\" (preguntas/variables) y la \"y\" (respuestas/objetivo)\n",
        "X_train = train[feature_cols]\n",
        "y_train = train['SIN_max_diff7']\n",
        "\n",
        "X_test = test[feature_cols]\n",
        "y_test = test['SIN_max_diff7']\n",
        "\n",
        "print(\"--- DATOS PREPARADOS PARA RANDOM FOREST ---\")\n",
        "print(f\"Total de registros para entrenar: {len(X_train)} días\")\n",
        "print(f\"Total de registros para predecir: {len(X_test)} días\")\n",
        "print(f\"Variables que usará el modelo: {feature_cols}\")"
      ],
