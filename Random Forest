      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "print(\"=== INICIANDO MODELO RANDOM FOREST (CON MEJORAS DE VARIABLES) ===\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 1. CARGA DE DATOS Y AJUSTE DE TIMEZONE\n",
        "# ==============================================================================\n",
        "df = pd.read_csv('complete-dataset.csv', parse_dates=['DATETIME'], index_col='DATETIME')\n",
        "df.index = pd.to_datetime(df.index, utc=True).tz_localize(None)\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. RESUMEN DIARIO (RESAMPLE)\n",
        "# ==============================================================================\n",
        "df_daily = df.resample('D').agg({\n",
        "    'SIN': ['mean', 'max', 'min', 'std'],\n",
        "    'T02M': 'mean',\n",
        "    'RH2M': 'mean',\n",
        "    'ISHOLIDAY': 'max'\n",
        "})\n",
        "df_daily.columns = ['_'.join(col).strip() for col in df_daily.columns.values]\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. INGENIERÍA DE FEATURES (VARIABLES PREDICTORAS MEJORADAS)\n",
        "# ==============================================================================\n",
        "df_feat = df_daily.copy()\n",
        "\n",
        "# ---> Variable Objetivo\n",
        "df_feat['SIN_max_diff7'] = df_feat['SIN_max'].diff(7)\n",
        "\n",
        "# ---> Lags Básicos (Lo que ya teníamos)\n",
        "for lag in [1, 2, 3, 7, 14]:\n",
        "    df_feat[f'SIN_max_lag_{lag}'] = df_feat['SIN_max'].shift(lag)\n",
        "\n",
        "df_feat['T02M_mean_lag_1'] = df_feat['T02M_mean'].shift(1)\n",
        "df_feat['dayofweek'] = df_feat.index.dayofweek\n",
        "df_feat['month'] = df_feat.index.month\n",
        "\n",
        "# ---> 🌟 LA MEJORA: Olas de Calor e Inercia (Rolling Features) 🌟 <---\n",
        "# Calculamos promedios de los últimos 3 y 7 días (excluyendo \"hoy\" con shift(1))\n",
        "df_feat['T02M_mean_roll3'] = df_feat['T02M_mean'].shift(1).rolling(window=3).mean()\n",
        "df_feat['T02M_mean_roll7'] = df_feat['T02M_mean'].shift(1).rolling(window=7).mean()\n",
        "df_feat['SIN_max_roll3'] = df_feat['SIN_max'].shift(1).rolling(window=3).mean()\n",
        "\n",
        "# Limpiamos nulos generados por las ventanas de tiempo\n",
        "df_feat = df_feat.dropna()\n",
        "\n",
        "# Definimos las columnas a usar (incluyendo las nuevas 'roll')\n",
        "feature_cols = [c for c in df_feat.columns if 'lag' in c or 'roll' in c or c in ['dayofweek', 'month', 'ISHOLIDAY_max']]\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. DIVISIÓN DE DATOS (SPLIT 80/20)\n",
        "# ==============================================================================\n",
        "split_idx = int(0.8 * len(df_feat))\n",
        "train = df_feat.iloc[:split_idx]\n",
        "test = df_feat.iloc[split_idx:]\n",
        "\n",
        "X_train, y_train = train[feature_cols], train['SIN_max_diff7']\n",
        "X_test, y_test = test[feature_cols], test['SIN_max_diff7']\n",
        "\n",
        "# ==============================================================================\n",
        "# 5. ENTRENAMIENTO DEL MODELO\n",
        "# ==============================================================================\n",
        "modelo_rf_mejorado = RandomForestRegressor(\n",
        "    n_estimators=150,\n",
        "    max_depth=10,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "modelo_rf_mejorado.fit(X_train, y_train)\n",
        "\n",
        "# ==============================================================================\n",
        "# 6. PREDICCIÓN Y RECONSTRUCCIÓN DE LA DEMANDA\n",
        "# ==============================================================================\n",
        "y_pred_diff_test = modelo_rf_mejorado.predict(X_test)\n",
        "\n",
        "# Reconstruimos sumando el valor de hace 7 días\n",
        "y_pred_total_test = y_pred_diff_test + test['SIN_max'].shift(7).values\n",
        "\n",
        "# ==============================================================================\n",
        "# 7. EVALUACIÓN ESTADÍSTICA (MÉTRICAS)\n",
        "# ==============================================================================\n",
        "y_test_real = test['SIN_max'].values\n",
        "mascara = ~np.isnan(y_pred_total_test)\n",
        "\n",
        "mae = mean_absolute_error(y_test_real[mascara], y_pred_total_test[mascara])\n",
        "rmse = np.sqrt(mean_squared_error(y_test_real[mascara], y_pred_total_test[mascara]))\n",
        "r2 = r2_score(y_test_real[mascara], y_pred_total_test[mascara])\n",
        "\n",
        "print(\"\\n--- RESULTADOS: RANDOM FOREST MEJORADO ---\")\n",
        "print(f\"MAE:  {mae:.2f} MW\")\n",
        "print(f\"RMSE: {rmse:.2f} MW\")\n",
        "print(f\"R²:   {r2:.4f}\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 8. GRAFICAR NUEVA IMPORTANCIA DE VARIABLES\n",
        "# ==============================================================================\n",
        "importancias = modelo_rf_mejorado.feature_importances_\n",
