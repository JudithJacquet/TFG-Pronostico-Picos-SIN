      "source": [
        "# ==============================================================================\n",
        "# 5. ENTRENAMIENTO DEL MODELO RANDOM FOREST\n",
        "# ==============================================================================\n",
        "print('\\n--- INICIANDO ENTRENAMIENTO DEL RANDOM FOREST ---')\n",
        "\n",
        "# Configuramos el \"Bosque\":\n",
        "# n_estimators=150: Creamos 150 árboles de decisión diferentes.\n",
        "# max_depth=10: Limitamos la profundidad a 10 ramas para que no memoricen el ruido (evitar overfitting).\n",
        "# random_state=42: Semilla fija para que los resultados sean siempre idénticos al re-ejecutar.\n",
        "# n_jobs=-1: Usa todos los núcleos de tu procesador para entrenar mucho más rápido.\n",
        "modelo_rf = RandomForestRegressor(\n",
        "    n_estimators=150,\n",
        "    max_depth=10,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "# El modelo \"estudia\" la relación entre el clima/días (X_train) y los cambios de demanda (y_train)\n",
        "modelo_rf.fit(X_train, y_train)\n",
        "print(\"¡Entrenamiento completado!\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 6. PREDICCIÓN Y RECONSTRUCCIÓN DE LA DEMANDA\n",
        "# ==============================================================================\n",
        "# Le pedimos al modelo que adivine la variación (diff7) en base al clima del set de prueba (2022)\n",
        "y_pred_diff_test_rf = modelo_rf.predict(X_test)\n",
        "\n",
        "# ¡Paso clave! Reconstruimos el valor total (MW)\n",
        "# Predicción total de hoy = (Dato Real de hace 7 días) + (Variación calculada por el modelo)\n",
        "y_pred_total_test_rf = y_pred_diff_test_rf + test['SIN_max'].shift(7).values\n",
        "\n",
        "# ==============================================================================\n",
        "# 7. EVALUACIÓN ESTADÍSTICA (MÉTRICAS DE ERROR)\n",
        "# ==============================================================================\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "# Extraemos los valores reales totales (MW) para comparar\n",
        "y_test_real = test['SIN_max'].values\n",
        "\n",
        "# Filtramos los primeros 7 días del set de prueba. Al usar '.shift(7)',\n",
        "# las primeras semanas arrojan valores NaN (vacíos) porque no tienen 7 días hacia atrás en ese corte.\n",
        "mascara_validos = ~np.isnan(y_pred_total_test_rf)\n",
        "y_test_real_filtrado = y_test_real[mascara_validos]\n",
        "y_pred_rf_filtrado = y_pred_total_test_rf[mascara_validos]\n",
        "\n",
        "# Calculamos los errores\n",
        "# MAE (Error Absoluto Medio): Te dice en promedio por cuántos MW se equivocó el modelo, sin importar si fue por encima o por debajo.\n",
        "mae_rf = mean_absolute_error(y_test_real_filtrado, y_pred_rf_filtrado)\n",
        "\n",
        "# RMSE (Raíz del Error Cuadrático Medio): Penaliza fuertemente los errores muy grandes.\n",
        "# Si el modelo tiene un RMSE alto pero un MAE bajo, significa que suele acertar, pero cuando falla, falla catastróficamente.\n",
        "rmse_rf = np.sqrt(mean_squared_error(y_test_real_filtrado, y_pred_rf_filtrado))\n",
        "\n",
        "# R2 (Coeficiente de Determinación): De 0 a 1, qué porcentaje de la variación eléctrica explica el modelo.\n",
        "r2_rf = r2_score(y_test_real_filtrado, y_pred_rf_filtrado)\n",
        "\n",
        "print(\"\\n--- RESULTADOS DEL MODELO EN EL SET DE PRUEBA (AÑO 2022) ---\")\n",
        "print(f\"MAE  (Error Promedio): {mae_rf:.2f} MW\")\n",
        "print(f\"RMSE (Penalización max): {rmse_rf:.2f} MW\")\n",
        "print(f\"R²   (Precisión general): {r2_rf:.4f}\")"
