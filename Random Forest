        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import Ridge\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "print(\"=== MODELO HÍBRIDO DIFF7 (CON ACOTACIÓN FÍSICA) ===\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 1. CARGA DE DATOS Y RESUMEN DIARIO\n",
        "# ==============================================================================\n",
        "df = pd.read_csv('complete-dataset.csv', parse_dates=['DATETIME'], index_col='DATETIME')\n",
        "df.index = pd.to_datetime(df.index, utc=True).tz_localize(None)\n",
        "\n",
        "df_daily = df.resample('D').agg({\n",
        "    'SIN': 'max',\n",
        "    'T02M': 'mean',\n",
        "    'ISHOLIDAY': 'max'\n",
        "})\n",
        "df_daily.columns = ['SIN_max', 'T02M_mean', 'ISHOLIDAY_max']\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. INGENIERÍA DE FEATURES TÉRMICAS Y TARGET diff7\n",
        "# ==============================================================================\n",
        "df_feat = df_daily.copy()\n",
        "\n",
        "# Target estacional\n",
        "df_feat['SIN_max_diff7'] = df_feat['SIN_max'].diff(7)\n",
        "\n",
        "# Features térmicas explicativas\n",
        "df_feat['T02M_excess_30'] = np.maximum(0, df_feat['T02M_mean'] - 30)\n",
        "df_feat['T02M_excess_35'] = np.maximum(0, df_feat['T02M_mean'] - 35)\n",
        "df_feat['T02M_excess_30_sq'] = df_feat['T02M_excess_30'] ** 2\n",
        "df_feat['T02M_diff7'] = df_feat['T02M_mean'].diff(7)\n",
        "\n",
        "# Lags de demanda e inercia\n",
        "for lag in [1, 2, 3, 7, 14, 21, 28]:\n",
        "    df_feat[f'SIN_max_lag_{lag}'] = df_feat['SIN_max'].shift(lag)\n",
        "\n",
        "# Lags de temperatura\n",
        "for lag in [1, 2, 3, 7]:\n",
        "    df_feat[f'T02M_mean_lag_{lag}'] = df_feat['T02M_mean'].shift(lag)\n",
        "\n",
        "df_feat['T02M_mean_roll3'] = df_feat['T02M_mean'].shift(1).rolling(window=3).mean()\n",
        "df_feat['T02M_mean_roll7'] = df_feat['T02M_mean'].shift(1).rolling(window=7).mean()\n",
        "\n",
        "# Variables de calendario\n",
        "df_feat['dayofweek'] = df_feat.index.dayofweek\n",
        "df_feat['month'] = df_feat.index.month\n",
        "df_feat['is_weekend'] = (df_feat.index.dayofweek >= 5).astype(int)\n",
        "\n",
        "df_feat = df_feat.dropna()\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. DIVISIÓN DE DATOS (SPLIT TEMPORAL 80/20)\n",
        "# ==============================================================================\n",
        "feature_cols = [c for c in df_feat.columns if c not in ['SIN_max', 'SIN_max_diff7', 'T02M_mean']]\n",
        "\n",
        "split_idx = int(0.8 * len(df_feat))\n",
        "train = df_feat.iloc[:split_idx].copy()\n",
        "test = df_feat.iloc[split_idx:].copy()\n",
        "\n",
        "X_train = train[feature_cols]\n",
        "y_train_diff = train['SIN_max_diff7']\n",
        "\n",
        "X_test = test[feature_cols]\n",
        "y_test_diff = test['SIN_max_diff7']\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. ENTRENAMIENTO DEL MODELO HÍBRIDO\n",
        "# ==============================================================================\n",
        "\n",
        "# --- PASO A: Regresión Ridge\n",
        "pipeline_reg = Pipeline([\n",
        "    ('scaler', StandardScaler()),\n",
        "    ('regressor', Ridge(alpha=20.0))  # Aumentamos ligeramente alpha a 20.0 para mayor suavizado\n",
        "])\n",
        "\n",
        "pipeline_reg.fit(X_train, y_train_diff)\n",
        "\n",
        "# Predicciones de la regresión\n",
        "pred_diff_reg_train = pipeline_reg.predict(X_train)\n",
        "pred_diff_reg_test = pipeline_reg.predict(X_test)\n",
        "\n",
        "# --- PASO B: Cálculo de Residuos\n",
        "residuos_diff_train = y_train_diff - pred_diff_reg_train\n",
        "\n",
        "# --- PASO C: Random Forest sobre residuos\n",
        "rf_residuos = RandomForestRegressor(\n",
        "    n_estimators=150,\n",
        "    max_depth=8,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "rf_residuos.fit(X_train, residuos_diff_train)\n",
        "\n",
        "# Predicción de residuos\n",
        "pred_residuos_test = rf_residuos.predict(X_test)\n",
        "\n",
        "# ==============================================================================\n",
        "# 5. FUSIÓN, ACOTACIÓN FÍSICA (CLIPPING) Y RECONSTRUCCIÓN\n",
        "# ==============================================================================\n",
        "pred_diff_hibrido_test = pred_diff_reg_test + pred_residuos_test\n",
        "\n",
        "# 🌟 COTA FÍSICA: Definir límites basados en el histórico de entrenamiento (+15% de tolerancia)\n",
        "max_diff_permitido = y_train_diff.max() * 1.15\n",
        "min_diff_permitido = y_train_diff.min() * 1.15\n",
        "\n",
        "# Aplicar clipping sobre la variación predicha\n",
        "pred_diff_hibrido_acotado = np.clip(pred_diff_hibrido_test, min_diff_permitido, max_diff_permitido)\n",
        "\n",
        "# Reconstrucción a niveles MW reales: y_pred = pred_diff_acotado + y_{t-7}\n",
        "pred_hibrido_reconstruido = pred_diff_hibrido_acotado + test['SIN_max'].shift(7).values\n",
        "\n",
        "# Filtrar NaNs generados por el shift(7)\n",
        "valid_idx = ~np.isnan(pred_hibrido_reconstruido)\n",
        "y_test_real = test['SIN_max'].values[valid_idx]\n",
        "y_pred_final = pred_hibrido_reconstruido[valid_idx]\n",
        "test_dates = test.index[valid_idx]\n",
        "\n",
        "# ==============================================================================\n",
        "# 6. EVALUACIÓN ESTADÍSTICA\n",
        "# ==============================================================================\n",
        "mae = mean_absolute_error(y_test_real, y_pred_final)\n",
