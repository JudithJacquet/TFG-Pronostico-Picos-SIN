        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Asegurarnos de que los datos estén ordenados temporalmente\n",
        "df['DATETIME'] = pd.to_datetime(df['DATETIME'], utc=True).dt.tz_convert('America/Asuncion')\n",
        "df = df.sort_values('DATETIME').reset_index(drop=True)\n",
        "\n",
        "# (Asumiendo que ya calculaste la columna 'HEAT_INDEX' como vimos antes)\n",
        "\n",
        "# =====================================================================\n",
        "# TÉCNICA 1: Promedios Móviles (La Acumulación de Calor Reciente)\n",
        "# =====================================================================\n",
        "# ¿Cuál fue la sensación térmica promedio en las últimas 24, 48 y 72 horas?\n",
        "# Esto le dice al modelo si venimos de una \"ola de calor\" sostenida.\n",
        "df['HEAT_INDEX_MA24H'] = df['HEAT_INDEX'].rolling(window=24, min_periods=1).mean()\n",
        "df['HEAT_INDEX_MA48H'] = df['HEAT_INDEX'].rolling(window=48, min_periods=1).mean()\n",
        "df['HEAT_INDEX_MA72H'] = df['HEAT_INDEX'].rolling(window=72, min_periods=1).mean()\n",
        "\n",
        "# =====================================================================\n",
        "# TÉCNICA 2: Rezagos de Picos Diarios (Estrés Térmico de Días Anteriores)\n",
        "# =====================================================================\n",
        "# ¿Cuál fue la sensación térmica MÁXIMA que soportó el sistema ayer y anteayer?\n",
        "# Primero, extraemos solo la fecha (sin la hora)\n",
        "df['DATE'] = df['DATETIME'].dt.date\n",
        "\n",
        "# Calculamos el pico máximo diario de sensación térmica\n",
        "daily_max = df.groupby('DATE')['HEAT_INDEX'].max().reset_index()\n",
        "daily_max.rename(columns={'HEAT_INDEX': 'DAILY_MAX_HI'}, inplace=True)\n",
        "\n",
        "# Desplazamos (shift) para obtener el pico de ayer (1D), hace dos días (2D), etc.\n",
        "daily_max['MAX_HI_LAG_1D'] = daily_max['DAILY_MAX_HI'].shift(1)\n",
        "daily_max['MAX_HI_LAG_2D'] = daily_max['DAILY_MAX_HI'].shift(2)\n",
        "daily_max['MAX_HI_LAG_3D'] = daily_max['DAILY_MAX_HI'].shift(3)\n",
        "\n",
        "# Volvemos a unir estos datos a nuestro dataset horario principal\n",
        "df = df.merge(daily_max[['DATE', 'MAX_HI_LAG_1D', 'MAX_HI_LAG_2D', 'MAX_HI_LAG_3D']], on='DATE', how='left')\n",
        "\n",
        "# =====================================================================\n",
        "# TÉCNICA 3: Rezagos Horarios Directos (Patrones Cíclicos)\n",
        "# =====================================================================\n",
        "# ¿Cuál era la sensación térmica exactamente a esta misma hora ayer o hace una semana?\n",
        "df['HEAT_INDEX_LAG_24H'] = df['HEAT_INDEX'].shift(24)\n",
        "df['HEAT_INDEX_LAG_168H'] = df['HEAT_INDEX'].shift(168) # 168 horas = 1 semana\n",
        "\n",
        "# Limpiar posibles valores nulos (NaN) generados por los desplazamientos iniciales\n",
        "df.dropna(inplace=True)"
